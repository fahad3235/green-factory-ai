# ==============================================================================
# Green Factory Brain AI — Environment Configuration Specification (.env)
# ==============================================================================
# All configuration variables have safe, zero-config offline defaults.
# Copy this file to '.env' if you wish to override port, host, or integration settings:
#   cp .env.example .env
#
# SECURITY NOTICE:
# - Never commit real API keys or industrial credentials to version control.
# - '.env' is automatically ignored by .gitignore to prevent accidental leakage.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Network Configuration
# ------------------------------------------------------------------------------
# Port to run the Node.js server on (Default: 4321)
PORT=4321

# Host interface to bind server to (Default: 0.0.0.0 for universal container/local access)
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. Operating & Telemetry Mode
# ------------------------------------------------------------------------------
# Options:
#   "simulation" (Default) — Deterministic offline factory physics and energy simulation.
#   "connected_readonly"   — Connects to read-only industrial IoT edge gateway (no equipment writes).
GFB_OPERATING_MODE=simulation

# Deterministic Pseudo-Random Seed for reproducible telemetry across evaluations (Default: 20261018)
GFB_SIMULATION_SEED=20261018

# ------------------------------------------------------------------------------
# 3. AI Copilot Model Configuration (Optional)
# ------------------------------------------------------------------------------
# Options:
#   "none" (Default) — Runs zero-latency grounded bilingual (EN/BN) rule-based simulation engine.
#   "gemini"         — Google Gemini API
#   "openai"         — OpenAI API
#   "anthropic"      — Anthropic Claude API
LLM_PROVIDER=none

# Optional API endpoint / reverse-proxy for server-side AI model integration
LLM_SERVER_ENDPOINT=

# Secret API key reference (Kept strictly server-side; NEVER exposed to client)
LLM_API_KEY=

# ------------------------------------------------------------------------------
# 4. Industrial IoT & EPMS Substation Integration (Optional)
# ------------------------------------------------------------------------------
# Optional telemetry edge gateway URL (Modbus/TCP, OPC-UA, or MQTT broker for sub-metering)
EPMS_READONLY_GATEWAY_URL=

# CRITICAL INDUSTRIAL SAFETY ENFORCEMENT SWITCH
# Must remain 'false' to prevent unauthorized remote commands to physical factory equipment.
ALLOW_PHYSICAL_EQUIPMENT_WRITE=false
