# ==============================================================================
# Green Factory Brain AI — Environment Configuration Template
# Copy to .env and fill in your API key (never commit real .env secrets to Git)
# ==============================================================================

# Primary LLM Provider ("groq" or "gemini")
LLM_PROVIDER=groq

# Groq Cloud API (Llama-3.3-70B-Versatile — free tier available at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API (Gemini 2.5 Flash fallback / alternative)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# FastAPI Runtime Settings
APP_ENV=development
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:4321,https://fahad3235.github.io
