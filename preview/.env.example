# Green Factory Brain AI — Environment Configuration Template
# IMPORTANT: Never commit real API keys or PLC/SCADA credentials to version control.
# All secret keys must remain strictly server-side.

# Operating Mode: "simulation" (default) | "connected_readonly"
GFB_OPERATING_MODE=simulation

# Deterministic Simulation Seed
GFB_SIMULATION_SEED=20261018

# Optional Server-Side AI Copilot Provider Configuration
# Leave blank to run in deterministic rule-based Demo Copilot mode.
LLM_PROVIDER=none
LLM_SERVER_ENDPOINT=
LLM_API_KEY_SECRET_REF=

# Optional Telemetry / EPMS Read-Only Adapter Endpoint
EPMS_READONLY_GATEWAY_URL=
# Physical equipment control is disabled by default for industrial safety.
ALLOW_PHYSICAL_EQUIPMENT_WRITE=false
